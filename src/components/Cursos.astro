---
import { useTranslations, type Lang } from "../i18n";
import EstudiosItem from "./EstudiosItem.astro";

export interface Props {
  lang: Lang;
}
interface CursoData {
  title: string;
  description: string;
  date2: string;
  link?: string;
}
const { lang } = Astro.props;
const { tArray } = useTranslations(lang);
const CURSOS = tArray<CursoData>("courses");
---

<ol class="relative ml-3.5" data-reveal-stagger>
  <div class="absolute inset-y-0 left-0 w-px bg-line" aria-hidden="true"></div>
  <div
    class="absolute inset-y-0 left-0 w-px origin-top bg-accent"
    data-timeline-progress
    aria-hidden="true"
  >
  </div>
  {
    CURSOS.map((curso) => (
    <li class="mb-10 ms-4" data-reveal-item>
      <EstudiosItem
        title={curso.title}
        description={curso.description}
        date2={curso.date2}
        link={curso.link}
        lang={lang}
      />
    </li>
    ))
  }
</ol>
