---
import { useTranslations, type Lang } from "../i18n";

interface Props {
  title: string;
  description: string;
  link?: string;
  date2: string;
  lang: Lang;
}
const { title, description, link, date2, lang } = Astro.props;
const { t } = useTranslations(lang);
---

<div
  class="absolute size-3 rounded-full border border-surface bg-accent mt-1.5 -start-[1.375rem]"
>
</div>
<p class="mb-1 text-sm font-normal leading-none text-ink-muted">{date2}</p>
<h3 class="text-lg font-semibold text-ink">
  {title}
</h3>
<p class="mb-4 text-base font-normal text-ink-muted text-pretty">
  {description}
</p>

{
  link && (
    <a
      target="_blank"
      href={link}
      class="inline-flex items-center px-4 py-2 text-sm font-medium text-white/70 bg-black border border-white/10 rounded-lg transition hover:text-white focus:z-10 focus:outline-none focus:ring-2 focus:ring-accent"
    >
      {t("studiesButton")}
      <svg
        class="w-3 h-3 ms-2 rtl:rotate-180"
        aria-hidden="true"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 14 10"
      >
        <path
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M1 5h12m0 0L9 1m4 4L9 9"
        />
      </svg>
    </a>
  )
}
