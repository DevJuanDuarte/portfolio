---
import ParallaxLayer from "./ParallaxLayer.astro";
---

<div class="pointer-events-none fixed inset-0 -z-10 overflow-hidden" aria-hidden="true">
  <ParallaxLayer
    speed={0.15}
    class="absolute -top-32 left-[-10%] size-[32rem] rounded-full bg-glow-1/20 blur-3xl dark:bg-glow-1/25"
  />
  <ParallaxLayer
    speed={0.3}
    class="absolute top-[40%] right-[-15%] size-[28rem] rounded-full bg-glow-3/15 blur-3xl dark:bg-glow-3/20"
  />
  <ParallaxLayer
    speed={0.45}
    class="absolute bottom-[-10%] left-[20%] size-[26rem] rounded-full bg-glow-2/15 blur-3xl dark:bg-glow-2/20"
  />
</div>
