---
import { useTranslations, type Lang } from "../i18n";

export interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { t } = useTranslations(lang);
---

<div class="grid gap-8 lg:grid-cols-[auto_1fr]">
  <div class="hidden h-full w-1 rounded-full bg-gradient-to-b from-accent to-transparent lg:block" aria-hidden="true"></div>
  <div class="flex flex-col gap-6">
    <p class="text-xl font-medium leading-relaxed text-ink lg:text-2xl" data-reveal>
      {t("about.p1")}
    </p>
    <p class="max-w-2xl text-base leading-relaxed text-ink-muted" data-reveal>
      {t("about.p2")}
    </p>
  </div>
</div>
