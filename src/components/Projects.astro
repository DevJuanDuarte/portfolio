---
import { useTranslations, type Lang } from "../i18n";
import Github from "./icons/Github.astro";
import Javascript from "./icons/Javascript.astro";
import MySQL from "./icons/MySQL.astro";
import Php from "./icons/Php.astro";
import React from "./icons/React.astro";
import Sass from "./icons/Sass.astro";
import Firebase from "./icons/Firebase.astro";
import Laravel from "./icons/Laravel.astro";
import Angular from "./icons/Angular.astro";
import Vue from "./icons/Vue.astro";
import Taildwindcss from "./icons/Taildwindcss.astro";

export interface Props {
  lang: Lang;
}
interface ProjectData {
  title: string;
  description: string;
}
interface TagData {
  name: string;
  class: string;
  icon: (_props: Record<string, any>) => any;
  iconClass?: string;
}
const { lang } = Astro.props;
const { t, tArray } = useTranslations(lang);

const TAGS: Record<string, TagData> = {
  MYSQL: {
    name: "MySQL",
    class: "bg-[#003159] text-white",
    icon: MySQL,
  },
  PHP: {
    name: "Php",
    class: "bg-[#003159] text-white",
    icon: Php,
  },
  JS: {
    name: "Javascript",
    class: "bg-[#f0db4f] text-black/80",
    icon: Javascript,
  },
  SASS: {
    name: "Sass",
    class: "bg-white text-black/80",
    icon: Sass,
  },
  REACT: {
    name: "React",
    class: "bg-[#0b1521] text-white",
    icon: React,
  },
  FIREBASE: {
    name: "Firebase",
    class: "bg-[#263238] text-white",
    icon: Firebase,
  },
  LARAVEL: {
    name: "Laravel",
    class: "bg-[#1a1a1a] text-white",
    icon: Laravel,
  },
  VUE: {
    name: "Vue",
    class: "bg-white text-black/80",
    icon: Vue,
  },
  TAILDWINDCSS: {
    name: "Tailwind CSS",
    class: "bg-[#0f172a] text-white",
    icon: Taildwindcss,
    iconClass: "h-3.5 w-6 shrink-0",
  },
  ANGULAR: {
    name: "Angular",
    class: "bg-[#DD0031] text-white",
    icon: Angular,
  },
};

const PROJECTS = [
{
    link: "https://github.com/DevJuanDuarte/usuarios_frontend",
    github: "https://github.com/DevJuanDuarte/usuarios_frontend",
    image: "/projects/login.png",
    tags: [TAGS.ANGULAR, TAGS.PHP, TAGS.MYSQL, TAGS.TAILDWINDCSS],
  },
  {
    link: "https://github.com/DevJuanDuarte/libreria_app",
    github: "https://github.com/DevJuanDuarte/libreria_app",
    image: "/projects/libreria.png",
    tags: [TAGS.LARAVEL, TAGS.VUE, TAGS.MYSQL, TAGS.TAILDWINDCSS],
  },
  {
    link: "https://github.com/DevJuanDuarte/Bienes_Raices",
    github: "https://github.com/devjuanduarte/Bienes_Raices",
    image: "/projects/bienesraices.png",
    tags: [TAGS.PHP, TAGS.MYSQL, TAGS.JS, TAGS.SASS],
  },
  {
    link: "https://github.com/DevJuanDuarte/citas-react",
    github: "https://github.com/DevJuanDuarte/citas-react",
    image: "/projects/vetcontrol.png",
    tags: [TAGS.REACT],
  },
];

const projectsData = tArray<ProjectData>("projects");
---

<div class="grid gap-8 p-6 lg:grid-cols-2" data-reveal-stagger>
  {PROJECTS.map(({ image, tags, link }, index) => {
    const project = projectsData[index];
    return (
    <div
      class="group flex max-w-full flex-col overflow-hidden rounded-2xl border border-line bg-surface-raised shadow-md transition-all duration-300 hover:-translate-y-1 hover:border-accent/60 hover:shadow-xl hover:shadow-accent/10"
      data-reveal-item
    >
      <div class="relative aspect-video w-full overflow-hidden">
        <img
          loading="lazy"
          class="size-full object-cover transition-transform duration-500 ease-out group-hover:scale-110"
          src={image}
          alt={`${t("projectAlt")} ${project?.title}`}
        />
        <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100" aria-hidden="true"></div>
      </div>

      <div class="flex flex-1 flex-col gap-4 p-5">
        <h3 class="text-xl font-semibold text-ink lg:text-2xl">
          {project?.title}
        </h3>
        <p class="flex-1 text-base font-normal leading-relaxed text-ink-muted">
          {project?.description}
        </p>

        <ul class="flex flex-row flex-wrap gap-2">
      {tags.map((tag) => (
        <li>
          <span
            class={`flex items-center gap-x-1.5 whitespace-nowrap rounded-full text-xs font-medium ${tag.class} py-1.5 pl-1.5 pr-3 border border-line`}
          >
            <tag.icon class={tag.iconClass ?? "size-5 shrink-0"} /> {tag.name}
          </span>
        </li>
      ))}
    </ul>

        <a
          href={link}
          target="_blank"
          class="mt-2 flex items-center justify-center gap-2 rounded-lg bg-black border border-white/10 px-4 py-2.5 text-sm font-medium text-white/70 transition hover:text-white focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 focus:ring-offset-surface-raised"
        >
          {t("projectButton")}
          <Github class="w-5 h-5" />
        </a>
      </div>
    </div>
    );
  })}
</div>
