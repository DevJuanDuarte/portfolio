---
import { useTranslations, type Lang } from "../i18n";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import ThemeToggle from "./ThemeToggle.astro";

export interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { t } = useTranslations(lang);
---

<header
  class="flex justify-center items-center mx-auto py-5 sticky top-0 w-full xl:w-[1120px] z-20 text-ink"
>
  <nav
    class="border border-line/60 rounded-full max-[640px]:justify-between max-[640px]:w-full max-[640px]:gap-x-2 mx-1 px-3 gap-x-6 py-1 flex flex-row items-center bg-surface-raised/75 backdrop-blur-2xl shadow-sm shadow-black/5"
  >
    <a
      class="hover:bg-accent-soft hover:text-accent lg:px-2 rounded-full transition"
      href="#experiencia">{t("nav.experience")}</a
    >
    <a class="hover:bg-accent-soft hover:text-accent lg:px-2 rounded-full transition" href="#sobre-mi"
      >{t("nav.about")}</a
    >
    <a class="hover:bg-accent-soft hover:text-accent lg:px-2 rounded-full transition" href="#proyectos"
      >{t("nav.projects")}</a
    >
    <a class="hover:bg-accent-soft hover:text-accent lg:px-2 rounded-full transition" href="#estudios"
      >{t("nav.studies")}</a
    >
    <a class="hover:bg-accent-soft hover:text-accent lg:px-2 rounded-full transition" href="#cursos"
      >{t("nav.courses")}</a
    >
    <ThemeToggle />
    <LanguageSwitcher lang={lang} />
  </nav>
</header>
