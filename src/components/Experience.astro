---
import { useTranslations, type Lang } from "../i18n";
import ExperienceItem from "./ExperienceItem.astro";

export interface Props {
  lang: Lang;
}
interface ExpData {
  title: string;
  description: string;
  date: string;
  link?: string;
}
const { lang } = Astro.props;
const { tArray } = useTranslations(lang);
const EXPERIENCE = tArray<ExpData>("experience");
---

<ol class="relative ml-3.5" data-reveal-stagger>
  <div class="absolute inset-y-0 left-0 w-px bg-line" aria-hidden="true"></div>
  <div
    class="absolute inset-y-0 left-0 w-px origin-top bg-accent"
    data-timeline-progress
    aria-hidden="true"
  >
  </div>
  {
    EXPERIENCE.map((exp) => (
    <li class="mb-10 ms-4" data-reveal-item>
      <ExperienceItem
        title={exp.title}
        description={exp.description}
        date={exp.date}
        link={exp.link}
        lang={lang}
      />
    </li>
    ))
  }
</ol>
