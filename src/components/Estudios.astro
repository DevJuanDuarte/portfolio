---
import { useTranslations, type Lang } from "../i18n";
import EstudiosItem from "./EstudiosItem.astro";

export interface Props {
  lang: Lang;
}
interface EstudioData {
  title: string;
  description: string;
  date2: string;
  link?: string;
}
const { lang } = Astro.props;
const { tArray } = useTranslations(lang);
const ESTUDIOS = tArray<EstudioData>("studies");
---

<ol class="relative ml-3.5" data-reveal-stagger>
  <div class="absolute inset-y-0 left-0 w-px bg-line" aria-hidden="true"></div>
  <div
    class="absolute inset-y-0 left-0 w-px origin-top bg-accent"
    data-timeline-progress
    aria-hidden="true"
  >
  </div>
  {
    ESTUDIOS.map((est) => (
    <li class="mb-10 ms-4" data-reveal-item>
      <EstudiosItem
        title={est.title}
        description={est.description}
        date2={est.date2}
        link={est.link}
        lang={lang}
      />
    </li>
    ))
  }
</ol>
